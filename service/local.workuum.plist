<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.workuum</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/workuum</string>
        <string>watch</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/workuum.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/workuum.log</string>
</dict>
</plist>
